{
  "name": "writings",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 DEPLOY_ADAPTER=none tinacms dev -c \"astro dev\"",
    "editor:dev": "node scripts/wbl-editor/start.mjs",
    "editor:test": "node --test scripts/wbl-editor/test-action-layer.mjs scripts/wbl-editor/test-article-layer.mjs scripts/wbl-editor/test-publisher.mjs",
    "build": "tinacms build --content=local -c \"astro build\" && node scripts/google-analytics.mjs inject",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\" && node scripts/google-analytics.mjs inject",
    "analytics:verify": "node scripts/google-analytics.mjs verify",
    "site:verify": "node scripts/verify-technical-eligibility.mjs",
    "obsidian:export": "python3 scripts/obsidian_pages.py export",
    "obsidian:sync": "python3 scripts/obsidian_pages.py sync",
    "obsidian:verify": "python3 scripts/obsidian_pages.py verify",
    "obsidian:publish": "python3 scripts/obsidian_pages.py publish",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:audit": "node scripts/audit-images.mjs",
    "bff:guide:worker": "node scripts/bff-guide/local-worker-server.mjs",
    "bff:guide:verify-worker": "node scripts/bff-guide/verify-worker.mjs",
    "bff:guide:verify-google-doc": "node scripts/bff-guide/verify-google-doc.mjs",
    "bff:archetype:authorize": "node scripts/bff-archetype/deploy-google-apps-script.mjs authorize",
    "bff:archetype:deploy": "node scripts/bff-archetype/deploy-google-apps-script.mjs deploy",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@tinacms/astro": "0.8.0",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@tinacms/cli": "4.0.3",
    "node": "22.23.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tinacms": "3.15.0",
    "wrangler": "4.152.0"
  }
}
