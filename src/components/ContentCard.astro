---
import { optimizedImageUrl } from '../lib/images';

export interface Props {
  href: string;
  title: string;
  date: Date;
  type: string;
  topics: string[];
  image?: string;
  square?: boolean;
  thumbnailTreatment?: 'blur-contain';
}
const { href, title, date, type, topics, image, square = false, thumbnailTreatment } = Astro.props;
const optimizedImage = image ? optimizedImageUrl(image, square ? 600 : 900) : undefined;
const purpleGradient = thumbnailTreatment === 'blur-contain';
const blurContain = square && thumbnailTreatment === 'blur-contain';
const weekday = date.toLocaleDateString('en-US', { weekday: 'short' });
const dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<a class:list={['entry', { 'entry-square': square }]} href={href} data-type={type.toLowerCase()} data-topics={topics.join(',')}>
  {image ? (
    <div class:list={['thumb', { 'thumb-purple-gradient': purpleGradient, 'thumb-blur-contain': blurContain }]}>
      {blurContain && (
        <img
          class="thumb-backdrop"
          src={optimizedImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          width="600"
          height="600"
          decoding="async"
        />
      )}
      <img
        class="thumb-foreground"
        src={optimizedImage}
        alt=""
        loading="lazy"
        width={square ? 600 : 900}
        height={square ? 600 : 506}
        decoding="async"
      />
    </div>
  ) : (
    <div class="thumb thumb-text" aria-hidden="true">
      <span class="hand-mark">{title.slice(0, 1)}</span>
    </div>
  )}
  {!square && (
    <div class="meta nav-font">
      <span class="cap-type">{type}</span>
      <span class="cap-sep">·</span>
      <span class="cap-weekday">{weekday}</span>
      <span class="cap-sep">·</span>
      <span class="cap-date">{dateStr}</span>
    </div>
  )}
  <h3 class="title">{title}</h3>
</a>
<style>
  .entry {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }
  .entry:hover, .entry:focus-visible { opacity: 0.82; text-decoration: none; }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e8dfd0;
    border-radius: 1px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .thumb-purple-gradient,
  .thumb-blur-contain {
    position: relative;
    isolation: isolate;
  }
  .thumb-purple-gradient::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      138deg,
      oklch(52% 0.15 305 / 0.26) 0%,
      oklch(46% 0.14 324 / 0.1) 48%,
      oklch(35% 0.14 284 / 0.24) 100%
    );
    pointer-events: none;
  }
  .thumb-blur-contain {
    background: #201b29;
  }
  .thumb-blur-contain .thumb-backdrop {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    filter: blur(18px) brightness(0.58);
    transform: scale(1.04);
  }
  .thumb-blur-contain .thumb-foreground {
    position: relative;
    z-index: 1;
    object-fit: contain;
  }
  .thumb-text {
    background: repeating-linear-gradient(
      180deg,
      #f4ede0 0,
      #f4ede0 30px,
      #e8dfd0 30px,
      #e8dfd0 31px
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hand-mark {
    font-family: 'Caveat', cursive;
    font-size: clamp(4rem, 8vw, 7rem);
    color: rgba(90, 74, 122, 0.5);
    transform: rotate(-4deg);
    line-height: 1;
  }

  .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faded);
    margin: 1rem 0 0.35rem;
    flex-wrap: wrap;
  }
  .cap-type { color: var(--accent); font-weight: 500; }
  .cap-weekday { font-family: 'Caveat', cursive; font-size: 0.95rem; text-transform: none; letter-spacing: 0; color: var(--accent-soft); line-height: 1; }
  .cap-sep { color: var(--line); }

  .title {
    text-align: center;
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(0.95rem, 0.9rem + 0.2vw, 1.05rem);
    line-height: 1.35;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
    letter-spacing: 0;
  }

  .entry-square .thumb { aspect-ratio: 1 / 1; }
  .entry-square .hand-mark { font-size: clamp(3rem, 6vw, 5rem); }
  .entry-square .title {
    margin-top: 0.75rem;
    font-size: clamp(0.85rem, 0.8rem + 0.2vw, 1rem);
  }
</style>
