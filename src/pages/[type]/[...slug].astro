---
import Base from '../../layouts/Base.astro';
import BookTabs from '../../components/BookTabs.astro';
import WblArticleEditor from '../../components/WblArticleEditor.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { TYPES, topicBySlug } from '../../topics';
import { getAllEntries, entryUrl } from '../../lib/content';
import { optimizedImageUrl } from '../../lib/images';
import { VOLUMES, entryBelongsToVolume } from '../../volumes';

type AnyEntry =
  | CollectionEntry<'guides'>
  | CollectionEntry<'stories'>
  | CollectionEntry<'notes'>
  | CollectionEntry<'reflections'>
  | CollectionEntry<'tools'>;

export async function getStaticPaths() {
  const collections = ['guides', 'stories', 'notes', 'reflections', 'tools'] as const;
  const typeFromCollection: Record<typeof collections[number], string> = {
    guides: 'guide',
    stories: 'story',
    notes: 'note',
    reflections: 'reflection',
    tools: 'tool',
  };
  const paths: { params: { type: string; slug: string }; props: { entry: AnyEntry } }[] = [];
  for (const collection of collections) {
    const entries = await getCollection(collection);
    for (const entry of entries) {
      paths.push({
        params: { type: typeFromCollection[collection], slug: entry.id.replace(/\.md$/, '') },
        props: { entry: entry as AnyEntry },
      });
    }
  }
  return paths;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const editorSource = `src/content/${entry.collection}/${entry.id}`;
const base = import.meta.env.BASE_URL;
const heroImage = entry.data.image ? optimizedImageUrl(entry.data.image, 1400) : undefined;
const purpleGradient = entry.data.thumbnailTreatment === 'blur-contain';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const publishedTime = entry.data.date.toISOString();
const modifiedTime = (entry.data.modified ?? entry.data.date).toISOString();
const primaryTopic = entry.data.topics[0];
const typeLabel = TYPES.find((type) => type.slug === entry.data.type)?.label ?? entry.data.type;
const volume = VOLUMES.find((candidate) => entryBelongsToVolume(entry.data.topics, candidate)) ?? VOLUMES[0];
const sectionHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(heroImage ? { image: [heroImage] } : {}),
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: { '@type': 'Person', name: 'Lala Dimalanta', url: 'https://writingsbylala.com/about/' },
  publisher: { '@type': 'Organization', name: 'Writings by Lala', url: 'https://writingsbylala.com/' },
  articleSection: primaryTopic,
  keywords: entry.data.topics.join(', '),
  additionalType: entry.data.type,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://writingsbylala.com/' },
      { '@type': 'ListItem', position: 2, name: typeLabel, item: `https://writingsbylala.com/library/?type=${entry.data.type}` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonicalUrl },
    ],
  },
};

const weekdayStr = entry.data.date.toLocaleDateString('en-US', { weekday: 'long' });
const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const all = await getAllEntries();
const relatedManual = (entry.data.related ?? [])
  .map((slug) => all.find((candidate) => candidate.id.replace(/\.md$/, '') === slug))
  .filter(Boolean) as AnyEntry[];
const relatedIds = new Set(relatedManual.map((candidate) => candidate.id));
const sameTopicAuto = all
  .filter((candidate) => (
    candidate.id !== entry.id
    && !relatedIds.has(candidate.id)
    && candidate.data.topics.some((topic) => entry.data.topics.includes(topic))
  ))
  .slice(0, Math.max(0, 4 - relatedManual.length));
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={heroImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  structuredData={structuredData}
  immersive
>
  {import.meta.env.DEV && (
    <WblArticleEditor route={Astro.url.pathname} source={editorSource} body={entry.body ?? ''} />
  )}
  <a class="skip-link" href="#article-body">Skip to the article</a>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <section
    class="reader-stage"
    data-reader-stage
    style={`--volume-accent: ${volume.color}; --volume-ink: ${volume.ink};`}
  >
    <div class="reader-book" data-reader-book>
      <div class="page-edges" aria-hidden="true"></div>

      <aside class="reader-notes">
        <div class="notes-inner">
          <header class="running-head">
            <a href={`/${volume.slug}/`}>Volume {volume.roman}: {volume.label}</a>
            <span>{typeLabel}</span>
          </header>

          {heroImage && (
            <div class:list={['hero-frame', { 'hero-purple-gradient': purpleGradient }]}>
              <img src={heroImage} alt="" width="1400" decoding="async" />
            </div>
          )}

          <div class="article-meta">
            <p class="type-label">{typeLabel}</p>
            <p>{weekdayStr}<br />{dateStr}</p>
          </div>

          {sectionHeadings.length > 0 && (
            <nav class="on-this-page" aria-label="On this page">
              <p class="handwritten">keep your place</p>
              <ol>
                {sectionHeadings.map((heading) => (
                  <li class:list={{ nested: heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <nav class="reader-returns" aria-label="Leave this article">
            <a href={`/${volume.slug}/`}>Back to {volume.label}</a>
            <a href="/">Close the book</a>
          </nav>
        </div>
      </aside>

      <article class="reader-paper" id="article-body">
        <header class="article-head">
          <div class="paper-running-head">
            <span>Writings by Lala</span>
            <span>{volume.label}</span>
          </div>
          <h1>{entry.data.title}</h1>
          <p class="lede">{entry.data.description}</p>
          {entry.data.topics.length > 0 && (
            <div class="topic-row">
              {entry.data.topics.map((topicSlug) => {
                const topic = topicBySlug(topicSlug);
                return topic ? <a href={`/topics/${topic.slug}/`}>{topic.name}</a> : null;
              })}
            </div>
          )}
        </header>

        <div class="prose">
          <Content />
        </div>

        {(relatedManual.length > 0 || sameTopicAuto.length > 0) && (
          <aside class="related">
            <p class="handwritten">turn to another page</p>
            <h2>More to read</h2>
            <ul>
              {relatedManual.map((relatedEntry) => (
                <li><a href={entryUrl(relatedEntry, base)}>{relatedEntry.data.title}</a></li>
              ))}
              {sameTopicAuto.map((relatedEntry) => (
                <li><a href={entryUrl(relatedEntry, base)}>{relatedEntry.data.title}</a></li>
              ))}
            </ul>
          </aside>
        )}

        <footer class="paper-folio">
          <a href={`/${volume.slug}/`}>{volume.label} contents</a>
          <span>Writings by Lala</span>
        </footer>
      </article>

      <BookTabs active={volume.slug} />
    </div>
  </section>
</Base>

<style>
  :global(body.is-immersive) { background: #c8baa3; }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    padding: 0.7rem 1rem;
    background: #fffaf1;
    color: var(--ink);
    font-family: 'Inter', sans-serif;
  }

  .skip-link:focus { transform: none; }

  .reading-progress {
    position: fixed;
    z-index: 30;
    top: 0;
    right: 0;
    left: 0;
    height: 0.28rem;
    background: rgba(255, 250, 241, 0.5);
  }

  .reading-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--volume-accent, #cfc4ec);
    transition: width 100ms linear;
  }

  .reader-stage {
    min-height: 100svh;
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(6.5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem)
      clamp(1rem, 3vw, 2.5rem);
  }

  .reader-book {
    position: relative;
    width: min(72rem, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.35fr);
    align-items: stretch;
    border: 1px solid rgba(91, 68, 43, 0.18);
    border-radius: 0.72rem;
    background: #fffaf1;
    box-shadow: 0 1.4rem 2rem rgba(66, 44, 24, 0.2);
    isolation: isolate;
  }

  .reader-book::after {
    content: '';
    position: absolute;
    z-index: 5;
    top: 0;
    bottom: 0;
    left: 34.8%;
    width: 1.8rem;
    transform: translateX(-50%);
    background: #f4ecdf;
    box-shadow:
      -0.45rem 0 0.8rem rgba(70, 48, 28, 0.08),
      0.45rem 0 0.8rem rgba(70, 48, 28, 0.08);
    pointer-events: none;
  }

  .page-edges {
    position: absolute;
    z-index: -1;
    inset: 0.75rem -0.65rem -0.75rem 0.7rem;
    border-radius: 0.8rem;
    background: #eee3ce;
    box-shadow: 0.3rem 0.5rem 0.6rem rgba(74, 49, 26, 0.15);
  }

  .reader-notes,
  .reader-paper {
    min-width: 0;
    background-image: none;
  }

  .reader-notes {
    padding: clamp(1.6rem, 3vw, 2.6rem);
    border-radius: 0.7rem 0 0 0.7rem;
    background-color: color-mix(in srgb, var(--volume-accent) 16%, #fffaf1);
  }

  .notes-inner {
    position: sticky;
    top: 1.5rem;
    max-height: calc(100svh - 3rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .running-head,
  .paper-running-head,
  .paper-folio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--ink-faded);
  }

  .running-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(95, 72, 46, 0.24);
  }

  .running-head a { color: var(--volume-ink); }

  .hero-frame {
    position: relative;
    width: min(100%, 22rem);
    margin: 2rem auto 1.5rem;
    overflow: hidden;
    border: 0.42rem double color-mix(in srgb, var(--volume-accent) 68%, #fffaf1);
    background: #e8dfd0;
    box-shadow: 0 0.45rem 0.85rem rgba(66, 44, 24, 0.13);
  }

  .hero-frame img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 26rem;
    object-fit: cover;
  }

  .hero-purple-gradient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(138deg, rgba(100, 69, 145, 0.2), rgba(64, 46, 92, 0.08), rgba(45, 32, 70, 0.2));
    pointer-events: none;
  }

  .article-meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    margin: 0 0 1.7rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid rgba(95, 72, 46, 0.24);
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .article-meta p { margin: 0; }

  .type-label {
    color: var(--volume-ink);
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .handwritten {
    margin: 0;
    color: var(--volume-ink);
    font-family: 'Caveat', cursive;
    font-size: 1.15rem;
    font-weight: 600;
    transform: rotate(-1.5deg);
  }

  .on-this-page {
    margin-top: 1rem;
  }

  .on-this-page ol {
    max-height: 16rem;
    margin: 0.65rem 0 0;
    padding: 0 0 0 1.1rem;
    overflow-y: auto;
    color: var(--ink-faded);
  }

  .on-this-page li {
    margin: 0 0 0.55rem;
    padding-left: 0.2rem;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .on-this-page li.nested { margin-left: 0.8rem; }
  .on-this-page a { color: var(--ink-soft); }

  .reader-returns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(95, 72, 46, 0.24);
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
  }

  .reader-returns a { color: var(--volume-ink); }

  .reader-paper {
    position: relative;
    border-radius: 0 0.7rem 0.7rem 0;
    background-color: #fffaf1;
    padding: clamp(2rem, 4.5vw, 4rem) clamp(2rem, 5vw, 4.6rem) 1.5rem;
    transform-origin: left top;
  }

  .reader-book.is-turning .reader-paper {
    animation: article-turn 520ms cubic-bezier(0.72, 0, 0.22, 1) both;
  }

  @keyframes article-turn {
    0% { transform: rotateY(0); opacity: 1; }
    55% { transform: rotateY(-22deg); opacity: 0.86; }
    100% { transform: rotateY(-72deg); opacity: 0.18; }
  }

  .paper-running-head {
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(95, 72, 46, 0.24);
  }

  .article-head {
    max-width: 46rem;
    margin: 0 auto;
    padding: clamp(2.7rem, 6vw, 5.2rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .article-head h1 {
    margin: 0;
    font-size: clamp(3rem, 4vw + 1rem, 5.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lede {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 0.98rem + 0.5vw, 1.34rem);
    font-style: italic;
    line-height: 1.55;
  }

  .topic-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
  }

  .topic-row a {
    color: var(--volume-ink);
    text-decoration: underline;
    text-decoration-color: var(--volume-accent);
    text-decoration-thickness: 0.16rem;
    text-underline-offset: 0.28rem;
  }

  .prose {
    max-width: 43rem;
    margin: 0 auto;
    font-size: clamp(17px, 1rem + 0.15vw, 19px);
    line-height: 1.82;
  }

  .prose :global(p) { margin: 0 0 1.45rem; }

  .prose :global(h2) {
    margin: 3.2rem 0 1rem;
    font-size: clamp(2rem, 1.55rem + 1.4vw, 2.8rem);
    scroll-margin-top: 1.8rem;
  }

  .prose :global(h3) {
    margin: 2.5rem 0 0.85rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.45rem, 1.2rem + 0.7vw, 1.85rem);
    letter-spacing: 0;
    scroll-margin-top: 1.8rem;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.8rem 0 0.8rem 1.35rem;
    border-left: 0.28rem solid var(--volume-accent);
    color: var(--ink-soft);
    font-style: italic;
  }

  .prose :global(code) {
    padding: 0.1rem 0.35rem;
    border-radius: 0.18rem;
    background: color-mix(in srgb, var(--volume-accent) 20%, transparent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.25rem;
    background: #211b27;
    color: #f4ede0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .prose :global(pre code) { padding: 0; background: transparent; color: inherit; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.45rem; padding-left: 1.45rem; }
  .prose :global(li) { margin-bottom: 0.42rem; }

  .prose :global(table) {
    display: block;
    width: 100%;
    margin: 1.9rem 0 2.2rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.7rem 0.8rem;
    border: 1px solid rgba(95, 72, 46, 0.25);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: color-mix(in srgb, var(--volume-accent) 18%, #fffaf1);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
  }

  .prose :global(img) { max-width: 100%; height: auto; border-radius: 0.2rem; }
  .prose :global(hr) { margin: 2.7rem 0; border: 0; border-top: 1px solid rgba(95, 72, 46, 0.25); }

  .related {
    max-width: 43rem;
    margin: 4.5rem auto 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(95, 72, 46, 0.25);
  }

  .related h2 { margin: 0.2rem 0 1rem; font-size: 1.8rem; }
  .related ul { margin: 0; padding: 0; list-style: none; }
  .related li { padding: 0.65rem 0; border-bottom: 1px solid rgba(95, 72, 46, 0.18); }
  .related a { color: var(--ink); font-weight: 600; }

  .paper-folio {
    margin-top: 4rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(95, 72, 46, 0.24);
  }

  .paper-folio a { color: var(--volume-ink); }

  @media (max-width: 900px) {
    .reader-stage { padding-right: 6rem; }
    .reader-book { grid-template-columns: minmax(15rem, 0.62fr) minmax(0, 1.38fr); }
    .reader-book::after { left: 31%; }
    .reader-paper { padding-right: 2.4rem; padding-left: 2.4rem; }
  }

  @media (max-width: 760px) {
    .reader-stage { padding: 1rem 0.65rem 4rem; }

    .reader-book {
      display: flex;
      flex-direction: column;
      border-radius: 0.5rem;
    }

    .reader-book::after { display: none; }
    .page-edges { inset: 3.5rem -0.2rem -0.5rem 0.25rem; }

    .reader-notes {
      padding: 1.35rem;
      border-radius: 0;
      border-bottom: 1px solid rgba(95, 72, 46, 0.25);
    }

    .notes-inner { position: static; max-height: none; overflow: visible; }

    .hero-frame {
      width: min(100%, 19rem);
      margin: 1.5rem auto;
    }

    .on-this-page ol { max-height: none; }

    .reader-paper {
      border-radius: 0 0 0.5rem 0.5rem;
      padding: 1.35rem 1.3rem 1rem;
    }

    .article-head { padding-top: 2.8rem; }
    .article-head h1 { font-size: clamp(2.8rem, 14vw, 4.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress span { transition: none; }
    .reader-book.is-turning .reader-paper { animation: none; }
  }
</style>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('#article-body');
  const readerBook = document.querySelector<HTMLElement>('[data-reader-book]');
  const volumeLinks = document.querySelectorAll<HTMLAnchorElement>('[data-book-tab]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const updateProgress = () => {
    if (!progress || !article) return;
    const start = article.offsetTop;
    const distance = Math.max(1, article.offsetHeight - window.innerHeight);
    const percent = Math.min(100, Math.max(0, ((window.scrollY - start) / distance) * 100));
    progress.style.width = `${percent}%`;
  };

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  volumeLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!readerBook || reduceMotion.matches || link.getAttribute('aria-current') === 'page') return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      readerBook.classList.add('is-turning');
      readerBook.setAttribute('aria-busy', 'true');
      window.setTimeout(() => window.location.assign(link.href), 460);
    });
  });
</script>
