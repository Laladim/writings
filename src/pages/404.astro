---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found | Writings by Lala" description="This Writings by Lala page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you opened may have moved, or it may no longer exist.</p>
    <p>Looking for a SWAHG page? We're now <a href="/bonafide-filipino-freelancers/">Bonafide Filipino Freelancers</a>.</p>
  </section>
</Base>

<style>
  .not-found {
    max-width: 680px;
    margin: 0 auto;
    padding: 96px 24px 120px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font: 700 0.78rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a5a44;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1;
  }

  p {
    max-width: 56ch;
    font-size: 1.08rem;
    line-height: 1.7;
  }
</style>
