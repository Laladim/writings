  .faq-kicker { color: var(--accent-soft); font-size: 1.15rem; margin: 0 0 0.25rem; }
  .faq h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); margin: 0 0 1.25rem; }
  .faq details { border-bottom: 1px solid color-mix(in srgb, var(--accent-soft), transparent 76%); padding: 0.2rem 0; }
  .faq summary { cursor: pointer; font-family: var(--font-nav); font-size: clamp(1.05rem, 1rem + 0.35vw, 1.25rem); line-height: 1.35; padding: 1rem 2rem 1rem 0; color: var(--ink); list-style: none; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; position: absolute; right: 0.25rem; top: 0.95rem; color: var(--accent); font-size: 1.35rem; line-height: 1; }
  .faq details[open] summary::after { content: "−"; }
  .faq details[open] summary { color: var(--accent); }
  .faq details p { margin: 0 0 1rem; color: var(--ink-soft); }
  .glory { margin-top: 2.5rem; color: var(--accent-soft); font-style: italic; }
  .sig { font-size: 1.6rem; color: var(--accent); margin-top: 0.25rem; }
</style>
